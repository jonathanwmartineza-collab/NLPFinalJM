{
  "name": "brainyapp2",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "description": "BrainyApp2: a free 31-agent product studio whose website runs AI in the browser with WebLLM.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate:team": "node scripts/validate-team.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "build:team": "node scripts/build-team.mjs",
    "prebuild": "node scripts/build-team.mjs && node scripts/stamp-version.mjs",
    "build": "vite build --config web/vite.config.ts",
    "dev": "vite --config web/vite.config.ts",
    "pretest": "node scripts/build-team.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.89",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
